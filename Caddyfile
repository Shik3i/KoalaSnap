koalasnap.net {
  root * /var/www/koalasnap.net/dist
  encode zstd gzip
  file_server

  # --- Security Header (Mozilla Observatory A+) ---
  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  }

  # --- Sprachpfade ---
  handle_path /de/* {
    root * /var/www/koalasnap.net/dist/de
    file_server
  }

  # Root = Englisch (kein Redirect!)
  handle {
    file_server
  }

  # 404 → SPA-Fallback via Root
  handle_errors {
    @404 {
      expression {http.error.status_code} == 404
    }
    rewrite @404 /index.html
    file_server
  }
}
